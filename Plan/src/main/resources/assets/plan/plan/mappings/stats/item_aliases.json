  "handling": {
    "lookup_order": [
      "Check mappings for an exact legacy item ID.",
      "If absent, check ambiguous.",
      "If neither exists, preserve the namespaced identifier unchanged."
    ],
    "ambiguous_policy": "Do not choose a possible target automatically; report or preserve the legacy statistic separately.",
    "namespace_policy": "Map only the path after minecraft:. Preserve non-minecraft namespaces unchanged."
  },
  "notes": [
    "This file covers item identifiers, not block identifiers; mined-block statistics need a separate block alias mapping.",
    "Some legacy item IDs represented multiple metadata variants. Their aggregate statistics cannot be reconstructed exactly.",
    "This is a focused alias list for changed identifiers, not a full list of all vanilla items."
  ],
